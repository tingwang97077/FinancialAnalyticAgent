# --- OpenAI ---
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_MODEL=gpt-5.4-mini # Default model
OPENAI_CLASSIFIER_MODEL=gpt-5.4-nano # Default classifier model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small # Default embedding

# --- MODEL Pricing (USD per 1M tokens) DEFAULT gpt-5.4-mini AND gpt-5.4-nano---
PRICE_MINI_INPUT=0.75
PRICE_MINI_CACHED_INPUT=0.075
PRICE_MINI_OUTPUT=4.50
PRICE_NANO_INPUT=0.20
PRICE_NANO_CACHED_INPUT=0.02
PRICE_NANO_OUTPUT=1.25
PRICE_EMBEDDING=0.02 # text-embedding-3-small, per 1M tokens

# --- Database ---
POSTGRES_USER=ffa_app
POSTGRES_PASSWORD=DEFINE_YOUR_PASSWORD
POSTGRES_DB=ffa
# Password of the PostgreSQL ffa_ro role, shared with Grafana.
GRAFANA_DATABASE_PASSWORD=DEFINE_YOUR_PASSWORD
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DATABASE_URL_READONLY=postgresql+psycopg://ffa_ro:${GRAFANA_DATABASE_PASSWORD}@localhost:5432/${POSTGRES_DB}

# --- SEC EDGAR ---
SEC_USER_AGENT=APP_NAME YOUR_EMAIL
SEC_MAX_RPS=8
SEC_CACHE_DIR=.sec_cache

# --- Universe ---
TICKER_UNIVERSE=AAPL,MSFT,NVDA,JPM,JNJ,WMT,BRK-B,KO,CAT,GOOGL,AMZN,META,AVGO,LLY,V,MA,HD,PG,COST,ABBV,BAC,CVX,PFE,MRK,PEP,MCD,DIS

# --- Retrieval ---
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP=0.15
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RETRIEVAL_STRATEGY=vector_rerank
EMBEDDING_DIM=1536

# --- Observability ---
LANGFUSE_PUBLIC_KEY=YOUR_PUBLIC_API_KEY
LANGFUSE_SECRET_KEY=YOUR_PRIVATE_API_KEY
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local interfaces ---
API_BASE_URL=http://localhost:8000
GRAFANA_BASE_URL=http://localhost:3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=YOUR_PASSWORD

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_JWT_SECRET=
