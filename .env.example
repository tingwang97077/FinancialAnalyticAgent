# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CLASSIFIER_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database ---
DATABASE_URL=postgresql+psycopg://ffa_app:pass@postgres:5432/ffa
DATABASE_URL_READONLY=postgresql+psycopg://ffa_ro:pass@postgres:5432/ffa

# --- SEC EDGAR ---
SEC_USER_AGENT=
SEC_MAX_RPS=8
SEC_CACHE_DIR=/data/sec_cache

# --- Universe ---
TICKER_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN

# --- Retrieval ---
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP=0.15
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
EMBEDDING_DIM=1536

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
PRICE_MINI_INPUT=
PRICE_MINI_CACHED_INPUT=
PRICE_MINI_OUTPUT=
PRICE_NANO_INPUT=
PRICE_NANO_CACHED_INPUT=
PRICE_NANO_OUTPUT=
PRICE_EMBEDDING=

# --- Local interfaces ---
API_BASE_URL=http://localhost:8000
GRAFANA_BASE_URL=http://localhost:3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_DATABASE_PASSWORD=

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
