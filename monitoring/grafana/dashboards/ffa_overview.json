          "rawQuery": true,
          "rawSql": "WITH bucketed AS (SELECT $__timeGroup(created_at, $__interval) AS time, SUM(COALESCE(cost_usd, 0))::double precision AS bucket_cost FROM query_logs WHERE $__timeFilter(created_at) GROUP BY 1) SELECT time, SUM(bucket_cost) OVER (ORDER BY time) AS \"Cumulative cost\" FROM bucketed ORDER BY time",
